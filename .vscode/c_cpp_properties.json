{
    "configurations": [
        {
            "name": "C.O.N.D.R.-x86_64",
            "includePath": [
                "${workspaceFolder}/kernel/include",
                "${workspaceFolder}/kernel"
            ],
            "defines": [
                "__x86_64__",
                "__ELF__"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerArgs": [
                "-mno-red-zone",
                "-mno-sse",
                "-mno-80387",
                "-mcmodel=kernel",
                "-ffreestanding",
                "-fno-pie",
                "-fno-exceptions",
                "-fno-rtti"
            ]
        }
    ],
    "version": 4
}