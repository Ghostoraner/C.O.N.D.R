{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C.O.N.D.R. (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/condr.elf",
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "miDebuggerServerAddress": "localhost:1234",
            "setupCommands": [
                {
                    "text": "set architecture x86_64"
                },
                {
                    "text": "symbol-file build/condr.elf"
                }
            ]
        }
    ]
}